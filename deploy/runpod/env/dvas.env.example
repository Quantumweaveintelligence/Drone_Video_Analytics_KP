# ════════════════════════════════════════════════════════════════════════════
# deploy/runpod/env/dvas.env.example — every variable the pod uses (no real values)
# The pod generates /workspace/dvas/secrets/dvas.env on first boot (bin/gen-secrets.sh).
# Any variable set in the RunPod template / RunPod Secrets overrides the file.
# ════════════════════════════════════════════════════════════════════════════

# ── Secrets (generated by gen-secrets.sh) ───────────────────────────────────
KC_DB_PASSWORD=
DVAS_DB_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KC_CLIENT_SECRET=                 # drone-ingest-client (backend login + edge upload)
ADMIN_CLIENT_ID=dvas-admin-service
ADMIN_CLIENT_SECRET=              # backend user management (service account)
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
ANALYTICS_SERVICE_KEY=            # backend ↔ analytics (X-Internal-Service-Key)
DVAS_SERVICE_KEY=                 # edge → /api/push/receive (X-DVAS-Service-Key)
EDGE_API_KEY=
JWT_SECRET=
FACE_VECTOR_ENCRYPTION_KEY=       # 64 hex chars (AES-256-GCM) — BACK UP OFFLINE
DRONE_IDS=DRONE_KL_001,DRONE_KL_002,DRONE_KL_003,DRONE_KL_004,DRONE_KL_005,DRN-001,DRN-002,DRN-003,DRN-004,DRN-005

# ── Set by dvas-init.sh (override only if you know why) ─────────────────────
# PUBLIC_BASE_URL=https://<POD_ID>-80.proxy.runpod.net   (derived from RUNPOD_POD_ID)
# DVAS_DEPLOYMENT=cloud  DVAS_RUNTIME=supervisor  SECURE_COOKIES=true
# ANALYTICS_DATABASE_URL / DASHBOARD_DATABASE_URL → mapped to DATABASE_URL per program
# REDIS_URL, MINIO_ENDPOINT, KEYCLOAK_URL, KC_REALM, KC_CLIENT_ID, CORS_ORIGINS,
# ALLOWED_ORIGINS, *_ANALYTICS_URL, *_URL, ANALYTICS_GATEWAY_URL, KNOWN_DRONES

# ── Tunables (template environment) ─────────────────────────────────────────
VRAM_OFFLOAD_ON_STOP=false        # keep models on the GPU when a stream stops
CROWD_MAX_FPS=2                   # crowd inferences per second per drone (F19)
CROWD_ALERT_THRESHOLD=50
QUEUE_MAX_LENGTH=300              # Valkey stream MAXLEN per drone (10 s at 30 fps)
QUEUE_MSG_TTL_MS=30000
MAX_FRAME_MB=5
INTRUSION_DEFAULT_PRESET=default
LOG_LEVEL=INFO
# Evidence (docs/evidence-reports, E2/E5) — defaults shown; confirm with legal (Q2/Q5)
# EVIDENCE_RETENTION_DAYS=90      # object-lock retention of the evidence vault copies
# PII_VIEW_ROLES=control_room_officer,senior_officer   # who may view face / plate images
# Reports (R2/R3)
# DVAS_REPORT_DB_PASSWORD=        # generated by gen-secrets.sh (read-only analytics role dvas_report_ro)
# REPORT_BASEMAP_MBTILES=/workspace/dvas/maps/kerala.mbtiles   # optional offline raster base map
# DVAS_DEV_MODE=1                 # run Python code from /workspace/dvas/code (test only)
# KC_JAVA_OPTS_APPEND=-Xms256m -Xmx1536m
# BACKUP_KEEP_SETS=3  DISK_WARN_PCT=80

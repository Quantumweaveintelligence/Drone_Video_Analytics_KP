# .dockerignore — Kerala Police Drone Analytics
# Excludes large/sensitive/generated files from Docker build context.
# This dramatically speeds up builds (the MP4 files alone are >5 GB).

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
.env

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# ── Large video files (mounted as volumes, NOT baked into images) ─────────────
*.MP4
*.mp4
*.avi
*.mov
*.mkv
*.MOV

# ── Test artifacts ────────────────────────────────────────────────────────────
tests/
htmlcov/
.coverage
.pytest_cache/
*.log

# ── IDE and OS files ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
.DS_Store
desktop.ini

# ── Git ───────────────────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── Documentation (not needed in containers) ─────────────────────────────────
*.md
*.docx
*.pdf
DVAS_Production_Roadmap_2Member.md

# ── TLS certificates (mounted as volumes) ────────────────────────────────────
ingest/certs/

# ── Ingest sub-directory docker-compose (root one is used) ───────────────────
ingest/docker-compose.yml

# ── Buffer storage (runtime data, mounted as volume) ─────────────────────────
buffer_storage/
logs/

# ── Node/npm (if any tools installed) ────────────────────────────────────────
node_modules/

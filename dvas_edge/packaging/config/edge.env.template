# ============================================================
# DVAS Edge Operator — Per-Laptop Configuration
# ============================================================
# This file is created by the installer wizard and stored at:
#   %LOCALAPPDATA%\DVAS_Edge\config\edge.env
#
# To change the ingest server URL: edit DVAS_CLOUD_URL and the four
# INGEST__*URL lines below, then restart the app.
# ============================================================

# Cloud server URL (RunPod or local Ubuntu server)
DVAS_CLOUD_URL=https://4nrza3dukc231h-80.proxy.runpod.net

# Ingest endpoints
INGEST__URL=https://4nrza3dukc231h-80.proxy.runpod.net/ingest/frame
INGEST__MISSION_START_URL=https://4nrza3dukc231h-80.proxy.runpod.net/ingest/mission/start
INGEST__MISSION_END_URL=https://4nrza3dukc231h-80.proxy.runpod.net/ingest/mission/end
INGEST__TOKEN_URL=https://4nrza3dukc231h-80.proxy.runpod.net/realms/kerala-police-drone/protocol/openid-connect/token

# Keycloak client credentials
INGEST__CLIENT_ID=drone-ingest-client
INGEST__CLIENT_SECRET=<KC_CLIENT_SECRET>

# Per-laptop uploader credentials (one account per laptop: edge_laptop_01..03)
INGEST__USERNAME=edge_laptop_01
INGEST__PASSWORD=<per-laptop password>

# Drone identity
INGEST__DRONE_ID=DRN-001

# TLS verification (true for RunPod with public cert, false for local HTTP)
INGEST__TLS_VERIFY=true

# Edge API authentication (local zero-trust key)
EDGE_API_KEY=<EDGE_API_KEY>
REQUIRE_EDGE_AUTH=true

# Local ports (optional; auto-finds next free port if occupied)
# DVAS_PORT=8765
# DVAS_CORE_PORT=8766

# Environment
ENV=production

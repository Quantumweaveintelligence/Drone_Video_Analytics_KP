# ============================================================
# DVAS Edge Operator — Per-Laptop Configuration
# ============================================================
# This file is created by the installer wizard and stored at:
#   %LOCALAPPDATA%\DVAS_Edge\config\edge.env
#
# To change the ingest server: edit INGEST__BASE_URL below (or use the app:
# Settings > Ingest server URL). Every endpoint is derived from it.
# Secrets (INGEST__CLIENT_SECRET, INGEST__PASSWORD, EDGE_API_KEY) are moved to an
# encrypted store (Windows DPAPI) on first start and blanked here.
# ============================================================

# Cloud dashboard and ingest server (same RunPod host)
DVAS_CLOUD_URL=https://<pod>-80.proxy.runpod.net
INGEST__BASE_URL=https://<pod>-80.proxy.runpod.net

# Optional (LAN installs only): Keycloak reached directly instead of through NGINX
# INGEST__TOKEN_URL=http://<lan-ip>:8080/realms/kerala-police-drone/protocol/openid-connect/token

# Keycloak client credentials
INGEST__CLIENT_ID=drone-ingest-client
INGEST__CLIENT_SECRET=<KC_CLIENT_SECRET>

# Per-laptop uploader credentials (one account per laptop: edge_laptop_01..03)
# INGEST__USERNAME auto-detected from Windows computer name (Solution 3)
INGEST__PASSWORD=<per-laptop password>

# Drone identity
INGEST__DRONE_ID=DRN-000

# TLS verification (true for RunPod with public cert, false for local HTTP)
INGEST__TLS_VERIFY=true

# Edge API authentication (local zero-trust key)
EDGE_API_KEY=<EDGE_API_KEY>
REQUIRE_EDGE_AUTH=true

# Local ports (optional; auto-finds next free port if occupied)
# DVAS_PORT=8765
# DVAS_CORE_PORT=8766

# Environment
ENV=production
